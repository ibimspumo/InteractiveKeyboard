{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InteractiveKeyboard",
  "version": "0.1.0",
  "identifier": "de.agentz.interactivekeyboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Interactive Keyboard",
        "width": 1000,
        "height": 500,
        "minWidth": 250,
        "minHeight": 250,
        "resizable": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": false,
        "shadow": false,
        "skipTaskbar": false,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**"],
          "deny": []
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/ibimspumo/InteractiveKeyboard/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "dialog": false
    }
  }
}
